Goal(
  name="create_agents ",
  description="create agents of a given agent type based on the number of new agents needed. If number of new agents needed is less than 0, no new agents will be created",
  category="",
  input_parameters={},
  output_parameters={},
  givens="number needed and simulation instance number of current agent is less than simulation instance number of total agent limit",
  makes="simulation instance number of current agents equals to simulation instance number of current agents plus number needed",
  means={}
);

Goal(
  name="impose_maximum_number_agents_limit ",
  description=" Given the number of new agents that will be added for an agent type, check if adding the new agents will exceed the maximum number of total agents limit. Reduce the number of new agents that will be added for the agent type if so",
  category="",
  input_parameters={},
  output_parameters={},
  givens="number needed  is greater than 0",
  makes=" number needed equals to minumum of those simulation instance number of total agents limit minus length of agent type agents and number needed",
  means={}
);

Goal(
  name="calculate_number_of_new_agents_needed",
  description="calculate the number of new agents needed for a given agent type based on the behavior the agent is engaging in. If the behavior is produce, the number of new agents needed is the production rate. If the behavior is maintain min population, the number is the difference between min population of the agent type and the current number of agents of the agent type. If the behavior is growth, the number is the current number of agents * growth rate",
  category="",
  input_parameters={},
  output_parameters={},
  givens="simulation instance number of current agents less than simulation instance number of total agent limit",
  makes=" ",
  means={}
);

Goal(
  name="change_parameters",
  description="calculate the number of new agents needed for a given agent type based on the behavior the agent is engaging in. If the behavior is produce, the number of new agents needed is the production rate. If the behavior is maintain min population, the number is the difference between min population of the agent type and the current number of agents of the agent type. If the behavior is growth, the number is the current number of agents * growth rate",
  category="",
  input_parameters={},
  output_parameters={},
  givens="parameter length equals to vals length",
  makes="first parameter instance value equals to first val and second parameter instance value equals to second val .... ",
  means={}
);


Goal(
  name="create_project",
  description="Create a project to describe the phenomenon you are observing and contain the models to test your various hypotheses",
  category="",
  input_parameters={(user, User)},
  output_parameters={(user, User), (project, Project)},
  givens="user != None && project == None",
  makes="project != None",
  means={(add_project, (user, project))}
);

Goal(
  name="create_model",
  description="Create a conceptual model base on an observed phenomenon.",
  category="",
  input_parameters={(user, User), (project, Project)},
  output_parameters={(user, User), (project, Project)},
  givens="user != None && project != None",
  makes="model != None",
  means={(add_model, (user, project)), (add_component, (model))}
);

Goal(
  name="is_user_exist",
  description="Check if user is a VERA user",
  category="",
  input_parameters={(user, User)},
  output_parameters={(user, User)},
  givens="user != None",
  makes="boolean_literal",
  means={(user_exist, user)}
);




(* Method Model *)
mechanisms = {user_exist_op, project_exist_op, add_project_op};

Organizer(
  name="add_project",
  description="Add a project",
  input_parameters={(user, User)},
  output_parameters={(user, User), (project, Project)},
  requires="user != None",
  provides="project != None",
  states={user_exist_s, project_not_exist_s, project_exist_s, project_added_s},
  transitions={t0},
  start_state="user_exists_s",
  success_state="project_added_s",
  failure_state="project_exist_s"
);

State(
  name="user_exist_s",
  description="",
  task_invocation=(is_user_exist_g, user)
);

State(
  name="project_not_exist_s",
  description="",
  task_invocation=(project_exist_op, project)
);

State(
  name="project_exist_s",
  description="",
  task_invocation=(project_exist_op, project)
);

State(
  name="project_added_s",
  description="",
  task_invocation=(add_project_op, project)
);

Transition(
  source_state="project_not_exist_s",
  target_state="project_added_s",
  data_condition="user_exist_s"
);

