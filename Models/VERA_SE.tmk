(* Knowledge Model *)
concepts = {Ecology_Model, VERA, NetLogo, EcologicalModelingSystem, Feature, InputData, Population, Ecological_System, AbioticFactor, Simulation, User, Ask_TMK, Behavior, AgentType, Agent, SimulationTick, What_If_Experiment, SimulationState, SimulationParameter};

Concept(
  name="Ecology_Model",
  description="An ecological model in VERA is a digital representation of an ecological system built by the user. It focuses on conceptual models, allowing users to visually represent the relationships between organisms (species) and their environment (abiotic factors) using components and connections. Components can be individual species like rabbits or foxes, or non-living environmental factors like temperature or water availability. Connections define interactions or behaviors between these components, such as predation (fox eating rabbit), competition (species competing for resources), or reproduction (population growth). VERA empowers users to: a) Construct models: Drag and drop components, define connections, and set parameters to build a conceptual representation of the desired ecological system. b) Run simulations: Simulate the interactions and behaviors within the model to see how the system evolves over time. c) Explore 'what if' scenarios: Run simulations with different initial conditions or change parameters to understand how the system might respond to various influences. Overall, VERA's ecological models provide a user-friendly way to represent and experiment with ecological systems, fostering an intuitive understanding of their dynamics without complex mathematical models.",
  super_concepts={},
  properties={}
);

Concept(
  name="VERA",
  description="A Virtual Ecological Research Assistant (VERA) web application that enables users to construct and explore ecological models.",
  super_concepts={},
  properties={Property("capabilities", "list", ""), Property("targetUsers", "list", ""), Property("benefits", "list", ""), Property("components", "list", ""), Property("conceptual modeling", "list", ""), Property("conceptual modeling steps", "list", "")}
);

Concept(
  name="NetLogo",
  description="A programmable multi-agent modeling platform used to create and simulate complex systems, including ecological models.",
  super_concepts={},
  properties={Property("capabilities", "list", ""), Property("targetUsers", "list", ""), Property("strengths", "list", ""), Property("weaknesses", "list", ""), Property("backend", "list", "")}
);

Concept(
  name="EcologicalModelingSystem",
  description="A general category encompassing software applications used to construct and simulate ecological models.",
  super_concepts={},
  properties={Property("type", "string", ""), Property("strengths", "list", ""), Property("weaknesses", "list", ""), Property("targetUsers", "list", "")}
);

