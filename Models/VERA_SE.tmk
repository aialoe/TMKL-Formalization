(* VERA Self-Explanation (SE) TMK Model Schema *)
 
Model (VERA_SE,
Task(
	name = create_project_task,
	description = "Create a project to describe the phenomenon you are observing and contain the models to test your various hypotheses",
	category = None,
	input_parameters = {(user, User)},
	output_parameters = {(user, User), (project, Project)},
	givens = user != None && project == None,
	makes = project != None,
	means = {(add_project, (user, project))}
);

Task( 
	name = create_model_task, 
	description = "Create a conceptual model base on an observed phenomenon.",  
	category = None,
	input_parameters = {(user, User), (project, Project)},
	output_parameters = {(user, User), (project, Project), (model, Model)},
	givens = user != None && project != None,
	makes = model != None,
	means = {(add_model, (user, project)), (add_component, (model))}
); 

Task( 
	name = is_user_exist_task, 
	description = "Check if user is a VERA user",  
	category = None,
	input_parameters = {(user, User)},
	output_parameters = {(user, User)},
	givens = user != None,
	makes = boolean_literal ,
	means = {(user_exist_method, user)}
); 
 
Operation(
	name = user_exist_method,
	description = "",  
	input_parameters = {(user, User)}, 
	output_parameters = {(user_exists, Boolean)} ,
	requires = True ,
	provides = True  
);
 
Operation(
	name = project_exist_method,
	description = "",  
	input_parameters = {(project, Project)}, 
	output_parameters = {(project_exists, Boolean)} ,
	requires = True ,
	provides = True  
);

Operation(
	name = add_project_method,
	description = "",  
	input_parameters = {(project, Project)}, 
	output_parameters = {(project, Project) },
	requires = True ,
	provides = True  
);


Organizer(
	name = add_project,
	description = "Add a project",
	input_parameters = {(user, User)},
	output_parameters = {(user, User), (project, Project)},
	requires = user != None,
	provides = project != None,
	states = {
	State(name = user_exists , task_invocation = (is_user_exist_task, task, (user)),description=""), 
	State(name = project_not_exist, task_invocation = (project_exist_method, operation, (project)),description=""), 
	State(name = project_added, task_invocation = (add_project_method, operation, (project)),description=""),
	State(name = project_exist, task_invocation = (project_exist_method, operation, (project)),description="")
	}, 
	transitions = {
	Transition(
	source_state = project_not_exist,
	target_state = project_added, 
	data_condition = user_exists())
	},
	start_state = user_exists ,
	success_state = project_added,
	failure_state = project_exist 
);

(*Define concept and relation within Knowledge*)
Knowledge (
Concept(name=project, description="A project is a way to organize your models.", super_concepts={}, properties={});
Concept(name=model, description="A conceptual model of your observed phenomenon.", super_concepts={}, properties={});
Concept(name=model_canvas, description="The graphical user interface where you buide your conceptual model.", super_concepts={}, properties={});
Concept(name=simulation, description="A graph that shows you how your components change over time.", super_concepts={}, properties={});
Concept(name=simulation_tab, description="The graphical user interface where you run simulation of your conceptual model.", super_concepts={}, properties={});
Concept(name=component, description="An element in your model.", super_concepts={}, properties={});
Concept(name=relationship, description="A description of how one component interact with another component in your model.", super_concepts={}, properties={});
Concept(name=property, description="An attribute of a component.", super_concepts={}, properties={});
Concept(name=parameter, description="A property which values determine the characteristics or behavior of an element in your model.", super_concepts={property}, properties={});

Concept(name=simulation_parameter, description="A property which integer evalues determine duration of a simulation.", 
		super_concepts={parameter, simulation, simulation_tab}, properties={Property ("simulation time limit", INTEGER_LITERAL, 2000) });

Concept(name=component_parameter, description="A property which determine the characteristics of a component.", 
		super_concepts={parameter, component}, properties={});
		
Concept(name=relationship_parameter, description="A property which determine the behavior of a component.", 
		super_concepts={parameter, relationship}, properties={});

Concept(name=assimilation_efficiency, description="An attribute of a living component. When one thing consumes another, not all the carbon is assimilated by the consumer – some is burned off, some is passed as waste.  This parameter is the percentage of carbon biomass retained by the consumer.", 
		super_concepts={parameter, component}, 
		properties={Property ("unit", INTEGER_LITERAL, 1)});
		
Concept(name=move_velocity, description="An attribute of a living component. Average velocity of the organisms in this population as they move in their environment.", 
		super_concepts={parameter, component}, 
		properties={Property ("unit mile per second", FLOAT_LITERAL, 0.00001)});
		
Concept(name=biotic_component, description="A living element in your model.", super_concepts={component, component_parameter}, 
		properties={assimilation_efficiency, move_velocity });

Concept(name=consumption_rate, description="The number of prey consumed by the predator per simulation tick.", 
		super_concepts={parameter, component}, 
		properties={Property ("unit number", FLOAT_LITERAL, 0.5)});
		
Concept(name=interaction_probability, description="The likelihood that two related species come into sufficiently close contact that an interaction takes place.", 
		super_concepts={parameter, component}, 
		properties={Property ("unit percentage", FLOAT_LITERAL, 0.5)});

Concept(name=abiotic_component, description="An non living component.", super_concepts={component, component_parameter}, 
		properties={consumption_rate, interaction_probability});

Relation(consumes, "predator consumes prey", predator, prey);
);


);
