  description="Data used to define the initial state and parameters of an ecological model.",
  super_concepts={},
  properties={Property("dataType", "string", ""), Property("description", "string", ""), Property("source", "string", ""), Property("targetConcept", "string", "")}
);

Concept(
  name="Population",
  description="A group of organisms of the same species living in a particular area.",
  super_concepts={},
  properties={Property("abundance", "number", ""), Property("Habitat", "Habitat", ""), Property("interactsWith", "list", "")}
);

Concept(
