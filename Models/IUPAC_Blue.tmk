(* TMK Model — exported by TMK Modeller *)

(* Task Model *)
goals = {CreateSystematicName, DeterminePrincipalCharacteristicGroup, DetermineSeniorParent, NameParentHydrideAndUnsaturation, CombineParentWithSuffix, IdentifySubstituentsAndLocants, AddStereodescriptors, FailureGoal, CompleteGoal};

Goal(
  name="CreateSystematicName",
  description="Generate a Preferred IUPAC Name (PIN) or systematic name for an organic compound using substitutive nomenclature.",
  category="",
  input_parameters={(initialConfiguration, configuration), (knowledgeBase, knowledgeBase)},
  output_parameters={(finalConfiguration, configuration)},
  givens="validChemicalStructure(initialConfiguration)",
  makes="validSystematicName(finalConfiguration)",
  means={SystematicNamingSolution}
);

Goal(
  name="DeterminePrincipalCharacteristicGroup",
  description="Step (a): Determine the principal characteristic group to be cited as the suffix based on seniority.",
  category="",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  givens="validChemicalStructure(initialConfig)",
  makes="principalGroupStepComplete(config)",
  means={PrincipalGroupMechanism}
);

Goal(
  name="DetermineSeniorParent",
  description="Step (b): Determine the senior parent amongst structural components attached to the principal characteristic group.",
  category="",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  givens="principalGroupStepComplete(config)",
  makes="seniorParentIdentified(config)",
  means={SeniorParentMechanism}
);

Goal(
  name="NameParentHydrideAndUnsaturation",
  description="Step (c): Name the parent hydride and specify any unsaturation (ene/yne endings).",
  category="",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  givens="seniorParentIdentified(config)",
  makes="parentNamed(config)",
  means={ParentNamingMechanism}
);

Goal(
  name="CombineParentWithSuffix",
  description="Step (d): Combine the name of the parent hydride with the suffix for the principal characteristic group.",
  category="",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  givens="parentNamed(config)",
  makes="parentAndSuffixCombined(config)",
  means={SuffixCombinationMechanism}
);

Goal(
  name="IdentifySubstituentsAndLocants",
  description="Steps (e-f): Identify substituents, add multiplicative prefixes, and assign locants to the complete structure, arranging the prefixes in alphabetical order.",
  category="",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  givens="parentAndSuffixCombined(config)",
  makes="substituentsAndLocantsAssigned(config)",
  means={SubstituentLocantMechanism}
);

Goal(
  name="AddStereodescriptors",
  description="Step (g): Determine chirality centres and other stereogenic units and add stereodescriptors.",
  category="",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  givens="substituentsAndLocantsAssigned(config)",
  makes="stereochemistryAssigned(config)",
  means={StereochemistryMechanism}
);

Goal(
  name="FailureGoal",
  description="Handle naming failure.",
  category="",
  input_parameters={},
  output_parameters={},
  givens="true",
  makes="failed(configuration)",
  means={}
);

Goal(
  name="CompleteGoal",
  description="Finalize naming process.",
  category="",
  input_parameters={},
  output_parameters={},
  givens="true",
  makes="completed(configuration)",
  means={}
);


(* Method Model *)
mechanisms = {ApplySeniority, ApplyParentSelectionCriteria, NameHydrideChainOrRing, SpecifyUnsaturation, ApplySuffixRules, ApplyNumberingRules, AssignStereodescriptors};

Organizer(
  name="SystematicNamingSolution",
  description="The main algorithm for creating systematic IUPAC names.",
  input_parameters={(initialConfig, configuration), (finalConfig, configuration)},
  output_parameters={(finalConfig, configuration)},
  requires="validChemicalStructure(initialConfig)",
  provides="validSystematicName(finalConfig)",
  states={SNS_S0, SNS_S1, SNS_S2, SNS_S3, SNS_S4, SNS_S5, SNS_Done, SNS_Fail},
  transitions={t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12},
  start_state="SNS_S0",
  success_state="SNS_Done",
  failure_state="SNS_Fail"
);

State(
  name="SNS_S0",
  description="",
  task_invocation=(DeterminePrincipalCharacteristicGroup, initialConfig)
);

State(
  name="SNS_S1",
  description="",
  task_invocation=(DetermineSeniorParent, initialConfig)
);

State(
  name="SNS_S2",
  description="",
  task_invocation=(NameParentHydrideAndUnsaturation, initialConfig)
);

State(
  name="SNS_S3",
  description="",
  task_invocation=(CombineParentWithSuffix, initialConfig)
);

State(
  name="SNS_S4",
  description="",
  task_invocation=(IdentifySubstituentsAndLocants, initialConfig)
);

State(
  name="SNS_S5",
  description="",
  task_invocation=(AddStereodescriptors, initialConfig)
);

State(
  name="SNS_Done",
  description="",
  task_invocation=(CompleteGoal)
);

State(
  name="SNS_Fail",
  description="",
  task_invocation=(FailureGoal)
);

Transition(
  source_state="SNS_S0",
  target_state="SNS_S1",
  data_condition="principalGroupStepComplete(initialConfig)"
);

Transition(
  source_state="SNS_S0",
  target_state="SNS_Fail",
  data_condition="!principalGroupStepComplete(initialConfig)"
);

Transition(
  source_state="SNS_S1",
  target_state="SNS_S2",
  data_condition="seniorParentIdentified(initialConfig)"
);

Transition(
  source_state="SNS_S1",
  target_state="SNS_Fail",
  data_condition="!seniorParentIdentified(initialConfig)"
);

Transition(
  source_state="SNS_S2",
  target_state="SNS_S4",
  data_condition="parentNamed(initialConfig)&& noGroupPresent(initialConfig)"
);

Transition(
  source_state="SNS_S2",
  target_state="SNS_S3",
  data_condition="parentNamed(initialConfig) && groupSelected(initialConfig)"
);

Transition(
  source_state="SNS_S2",
  target_state="SNS_Fail",
  data_condition="!parentNamed(initialConfig)"
);

Transition(
  source_state="SNS_S3",
  target_state="SNS_S4",
  data_condition="parentAndSuffixCombined(initialConfig)"
);

Transition(
  source_state="SNS_S3",
  target_state="SNS_Fail",
  data_condition="!parentAndSuffixCombined(initialConfig)"
);

Transition(
  source_state="SNS_S4",
  target_state="SNS_S5",
  data_condition="substituentsAndLocantsAssigned(initialConfig)"
);

Transition(
  source_state="SNS_S4",
  target_state="SNS_Fail",
  data_condition="!substituentsAndLocantsAssigned(initialConfig)"
);

Transition(
  source_state="SNS_S5",
  target_state="SNS_Done",
  data_condition="stereochemistryAssigned(initialConfig)|| noStereoPresent(initialConfig)"
);

Transition(
  source_state="SNS_S5",
  target_state="SNS_Fail",
  data_condition="!(stereochemistryAssigned(initialConfig)|| noStereoPresent(initialConfig))"
);

Organizer(
  name="PrincipalGroupMechanism",
  description="Selects the suffix group based on Seniority Order.",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="validChemicalStructure(config)",
  provides="principalGroupStepComplete(config)",
  states={PGM_S0, PGM_Done, PGM_Fail},
  transitions={t0, t1},
  start_state="PGM_S0",
  success_state="PGM_Done",
  failure_state="PGM_Fail"
);

State(
  name="PGM_S0",
  description="",
  task_invocation=(ApplySeniority, config)
);

State(
  name="PGM_Done",
  description="",
  task_invocation=(CompleteGoal)
);

State(
  name="PGM_Fail",
  description="",
  task_invocation=(FailureGoal)
);

Transition(
  source_state="PGM_S0",
  target_state="PGM_Done",
  data_condition="groupSelected(config) || noGroupPresent(config)"
);

Transition(
  source_state="PGM_S0",
  target_state="PGM_Fail",
  data_condition="!(groupSelected(config) || noGroupPresent(config))"
);

Organizer(
  name="SeniorParentMechanism",
  description="Selects parent based on IUPAC criteria (Principal Group > Senior Element > Rings/Chains).",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="true",
  provides="seniorParentIdentified(config)",
  states={SPM_S0, SPM_Done, SPM_Fail},
  transitions={t0, t1},
  start_state="SPM_S0",
  success_state="SPM_Done",
  failure_state="SPM_Fail"
);

State(
  name="SPM_S0",
  description="",
  task_invocation=(ApplyParentSelectionCriteria, config)
);

State(
  name="SPM_Done",
  description="",
  task_invocation=(CompleteGoal)
);

State(
  name="SPM_Fail",
  description="",
  task_invocation=(FailureGoal)
);

Transition(
  source_state="SPM_S0",
  target_state="SPM_Done",
  data_condition="parentSelected(config)"
);

Transition(
  source_state="SPM_S0",
  target_state="SPM_Fail",
  data_condition="!parentSelected(config)"
);

Organizer(
  name="ParentNamingMechanism",
  description="Assigns alkane name and modifies ending for unsaturation (ene/yne).",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="true",
  provides="parentNamed(config)",
  states={PNM_S0, PNM_S1, PNM_Done, PNM_Fail},
  transitions={t0, t1, t2, t3},
  start_state="PNM_S0",
  success_state="PNM_Done",
  failure_state="PNM_Fail"
);

State(
  name="PNM_S0",
  description="",
  task_invocation=(NameHydrideChainOrRing, config)
);

State(
  name="PNM_S1",
  description="",
  task_invocation=(SpecifyUnsaturation, config)
);

State(
  name="PNM_Done",
  description="",
  task_invocation=(CompleteGoal)
);

State(
  name="PNM_Fail",
  description="",
  task_invocation=(FailureGoal)
);

Transition(
  source_state="PNM_S0",
  target_state="PNM_S1",
  data_condition="hydrideNamed(config)"
);

Transition(
  source_state="PNM_S0",
  target_state="PNM_Fail",
  data_condition="!hydrideNamed(config)"
);

Transition(
  source_state="PNM_S1",
  target_state="PNM_Done",
  data_condition="unsaturationSpecified(config)"
);

Transition(
  source_state="PNM_S1",
  target_state="PNM_Fail",
  data_condition="!unsaturationSpecified(config)"
);

Organizer(
  name="SuffixCombinationMechanism",
  description="Decomposes Task (d): Joining the parent hydride name with the principal group suffix.",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="parentNamed(config)",
  provides="parentAndSuffixCombined(config)",
  states={SCM_S0, SCM_Done, SCM_Fail},
  transitions={t0, t1},
  start_state="SCM_S0",
  success_state="SCM_Done",
  failure_state="SCM_Fail"
);

State(
  name="SCM_S0",
  description="",
  task_invocation=(ApplySuffixRules, config)
);

State(
  name="SCM_Done",
  description="",
  task_invocation=(CompleteGoal)
);

State(
  name="SCM_Fail",
  description="",
  task_invocation=(FailureGoal)
);

Transition(
  source_state="SCM_S0",
  target_state="SCM_Done",
  data_condition="parentAndSuffixCombined(config)"
);

Transition(
  source_state="SCM_S0",
  target_state="SCM_Fail",
  data_condition="!parentAndSuffixCombined(config)"
);

Organizer(
  name="SubstituentLocantMechanism",
  description="Identifies substituents, arranges alphabetically, inserts multiplicative prefixes, and assigns locants.",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="parentAndSuffixCombined(config) || parentNamed(config)",
  provides="substituentsAndLocantsAssigned(config)",
  states={SLM_S0, SLM_Done, SLM_Fail},
  transitions={t0, t1},
  start_state="SLM_S0",
  success_state="SLM_Done",
  failure_state="SLM_Fail"
);

State(
  name="SLM_S0",
  description="",
  task_invocation=(ApplyNumberingRules, config)
);

State(
  name="SLM_Done",
  description="",
  task_invocation=(CompleteGoal)
);

State(
  name="SLM_Fail",
  description="",
  task_invocation=(FailureGoal)
);

Transition(
  source_state="SLM_S0",
  target_state="SLM_Done",
  data_condition="substituentsAndLocantsAssigned(config)"
);

Transition(
  source_state="SLM_S0",
  target_state="SLM_Fail",
  data_condition="!substituentsAndLocantsAssigned(config)"
);

Organizer(
  name="StereochemistryMechanism",
  description="Determines chirality centres and adds descriptors (R/S, E/Z).",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="true",
  provides="stereochemistryAssigned(config) || noStereoPresent(config)",
  states={STR_S0, STR_Done, STR_Fail},
  transitions={t0, t1},
  start_state="STR_S0",
  success_state="STR_Done",
  failure_state="STR_Fail"
);

State(
  name="STR_S0",
  description="",
  task_invocation=(AssignStereodescriptors, config)
);

State(
  name="STR_Done",
  description="",
  task_invocation=(CompleteGoal)
);

State(
  name="STR_Fail",
  description="",
  task_invocation=(FailureGoal)
);

Transition(
  source_state="STR_S0",
  target_state="STR_Done",
  data_condition="stereochemistryAssigned(config) || noStereoPresent(config)"
);

Transition(
  source_state="STR_S0",
  target_state="STR_Fail",
  data_condition="!(stereochemistryAssigned(config) || noStereoPresent(config))"
);

Operation(
  name="ApplySeniority",
  description="Atomic operation to compare groups against Seniority (Carboxylates > Carboxylic acids > Esters > Acid halides > Amides > Nitriles > Aldehydes > Ketones > Alcohols > Thiols > Amines > Imines).",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="true",
  provides="groupSelected(config) || noGroupPresent(config)"
);

Operation(
  name="ApplyParentSelectionCriteria",
  description="Atomic operation applying the hierarchy: Max Principal Groups, Senior Element, Rings > Chains, etc.",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="true",
  provides="parentSelected(config)"
);

Operation(
  name="NameHydrideChainOrRing",
  description="Atomic operation to assign the base name of the senior parent hydride (e.g., 'heptane', 'cyclohexane') based on the number of skeletal atoms and senior elements.",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="seniorParentIdentified(config)",
  provides="hydrideNamed(config)"
);

Operation(
  name="SpecifyUnsaturation",
  description="Atomic operation to identify double and triple bonds and modify the parent hydride name with 'en' or 'yn' endings and locants.",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="hydrideNamed(config)",
  provides="unsaturationSpecified(config)"
);

Operation(
  name="ApplySuffixRules",
  description="Atomic operation to join the principal characteristic group suffix to the parent name, applying elision rules (e.g., removing 'e' before 'ol', 'one', or 'oic acid').",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="parentNamed(config)",
  provides="parentAndSuffixCombined(config)"
);

Operation(
  name="ApplyNumberingRules",
  description="Atomic operation applying Numbering Criteria (Heteroatoms > Indicated H > Principal Characteristic Group(s) > Unsaturation ('ene', 'yne') and 'hydro' prefixes > All Substituents Cited by Prefixes > Substituents in the Order of Citation).",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="true",
  provides="substituentsAndLocantsAssigned(config)"
);

Operation(
  name="AssignStereodescriptors",
  description="Atomic operation to assign CIP descriptors (R/S, E/Z).",
  input_parameters={(config, configuration)},
  output_parameters={(config, configuration)},
  requires="true",
  provides="stereochemistryAssigned(config) || noStereoPresent(config)"
);


(* Knowledge Model *)
concepts = {configuration, chemicalStructure, systematicName, characteristicGroup, principalCharacteristicGroup, parentCompound, substituent, locant, stereodescriptor, multiplicativePrefix, unsaturationEnding};

Concept(
  name="configuration",
  description="The state of the naming process, containing the chemical structure and the building name string.",
  super_concepts={},
  properties={}
);

Concept(
  name="chemicalStructure",
  description="A representation of the organic molecule including atoms, bonds, and stereochemistry.",
  super_concepts={},
  properties={}
);

Concept(
  name="systematicName",
  description="The Preferred IUPAC Name (PIN) constructed by the process.",
  super_concepts={},
  properties={}
);

Concept(
  name="characteristicGroup",
  description="Functional groups attached to the parent compound.",
  super_concepts={},
  properties={}
);

Concept(
  name="principalCharacteristicGroup",
  description="The most senior characteristic group cited as a suffix.",
  super_concepts={},
  properties={}
);

Concept(
  name="parentCompound",
  description="The parent hydride (chain or ring) derived from the senior element and structure.",
  super_concepts={},
  properties={}
);

Concept(
  name="substituent",
  description="Groups cited as prefixes.",
  super_concepts={},
  properties={}
);

Concept(
  name="locant",
  description="Numbers or letters specifying position on the parent structure.",
  super_concepts={},
  properties={}
);

Concept(
  name="stereodescriptor",
  description="Descriptors such as R, S, E, Z, cis, trans used to specify configuration.",
  super_concepts={},
  properties={}
);

Concept(
  name="multiplicativePrefix",
  description="Prefixes like di, tri, tetra used when fragments occur multiple times.",
  super_concepts={},
  properties={}
);

Concept(
  name="unsaturationEnding",
  description="Endings such as 'en' or 'yn' denoting double or triple bonds.",
  super_concepts={},
  properties={}
);

