  name="isAttachedTo",
  description="",
  domain="substituent",
  range="parentCompound"
);

Relation(
  name="hasLocant",
  description="",
  domain="substituent",
  range="locant"
);

Relation(
  name="hasSuffix",
  description="",
  domain="parentCompound",
  range="principalCharacteristicGroup"
);

