Assertion(
  name="validSystematicName",
  description="Asserts that the configuration contains a valid IUPAC Systematic Name.",
  property="",
  equivalent_to="SystematicNamingSolution"
);

Assertion(
  name="principalGroupStepComplete",
  description="Asserts that the principal characteristic group has been selected. Can be null if a molecule has no characteristic group.",
  property="",
  equivalent_to="PrincipalGroupMechanism"
);

Assertion(
  name="seniorParentIdentified",
  description="Asserts that the senior parent hydride has been determined.",
  property="",
  equivalent_to="SeniorParentMechanism"
);

Assertion(
  name="hydrideNamed",
  description="Asserts that the base name of the senior parent hydride (chain or ring) has been determined.",
  property="",
  equivalent_to="NameHydrideChainOrRing"
);

Assertion(
  name="unsaturationSpecified",
  description="Asserts that double and triple bonds have been identified and the 'an' ending has been changed to 'en' or 'yn'.",
  property="",
  equivalent_to="SpecifyUnsaturation"
);

Assertion(
  name="parentNamed",
  description="Asserts that the parent hydride has been named and unsaturation (ene/yne) specified.",
  property="",
  equivalent_to="ParentNamingMechanism"
);

Assertion(
  name="parentAndSuffixCombined",
  description="Asserts that the name of hte parent hydride has been combined with the suffix for the principal characteristic group.",
  property="",
  equivalent_to="SuffixCombinationMechanism"
);

Assertion(
  name="substituentsAndLocantsAssigned",
  description="Asserts that the substituends, locants, multiplicative prefixes, and their ordering have been determined.",
  property="",
  equivalent_to="SubstituentLocantMechanism"
);

Assertion(
  name="SNS",
  description="Abbreviation for SystematicNamingSolution",
  property="",
  equivalent_to="SystematicNamingSolution"
);
