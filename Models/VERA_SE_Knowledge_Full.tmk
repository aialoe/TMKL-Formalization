(* TMK Model - exported by TMK Modeller *)

(* Knowledge Model *)
concepts = {Ecology_Model, VERA, NetLogo, EcologicalModelingSystem, Feature, InputData, Population, Ecological_System, AbioticFactor, Simulation, User, Ask_TMK, Behavior, AgentType, Agent, SimulationTick, What_If_Experiment, SimulationState, SimulationParameter};

Concept(
  name="Ecology_Model",
  description="An ecological model in VERA is a digital representation of an ecological system built by the user. It focuses on conceptual models, allowing users to visually represent the relationships between organisms (species) and their environment (abiotic factors) using components and connections. Components can be individual species like rabbits or foxes, or non-living environmental factors like temperature or water availability. Connections define interactions or behaviors between these components, such as predation (fox eating rabbit), competition (species competing for resources), or reproduction (population growth). VERA empowers users to: a) Construct models: Drag and drop components, define connections, and set parameters to build a conceptual representation of the desired ecological system. b) Run simulations: Simulate the interactions and behaviors within the model to see how the system evolves over time. c) Explore 'what if' scenarios: Run simulations with different initial conditions or change parameters to understand how the system might respond to various influences. Overall, VERA's ecological models provide a user-friendly way to represent and experiment with ecological systems, fostering an intuitive understanding of their dynamics without complex mathematical models.",
  super_concepts={},
  properties={}
);

Concept(
  name="VERA",
  description="A Virtual Ecological Research Assistant (VERA) web application that enables users to construct and explore ecological models.",
  super_concepts={},
  properties={Property("capabilities", "list", ""), Property("targetUsers", "list", ""), Property("benefits", "list", ""), Property("components", "list", ""), Property("conceptual modeling", "list", ""), Property("conceptual modeling steps", "list", "")}
);

Concept(
  name="NetLogo",
  description="A programmable multi-agent modeling platform used to create and simulate complex systems, including ecological models.",
  super_concepts={},
  properties={Property("capabilities", "list", ""), Property("targetUsers", "list", ""), Property("strengths", "list", ""), Property("weaknesses", "list", ""), Property("backend", "list", "")}
);

Concept(
  name="EcologicalModelingSystem",
  description="A general category encompassing software applications used to construct and simulate ecological models.",
  super_concepts={},
  properties={Property("type", "string", ""), Property("strengths", "list", ""), Property("weaknesses", "list", ""), Property("targetUsers", "list", "")}
);

Concept(
  name="Feature",
  description="An aspect of the ecological modeling system that enhances its capabilities.",
  super_concepts={},
  properties={Property("name", "string", ""), Property("description", "string", ""), Property("version", "string", ""), Property("dependencies", "list", ""), Property("benefits", "list", "")}
);

Concept(
  name="InputData",
  description="Data used to define the initial state and parameters of an ecological model.",
  super_concepts={},
  properties={Property("dataType", "string", ""), Property("description", "string", ""), Property("source", "string", ""), Property("targetConcept", "string", "")}
);

Concept(
  name="Population",
  description="A group of organisms of the same species living in a particular area.",
  super_concepts={},
  properties={Property("abundance", "number", ""), Property("Habitat", "Habitat", ""), Property("interactsWith", "list", "")}
);

Concept(
  name="Ecological_System",
  description="A representation of interacting organisms and their environment in a specific area.",
  super_concepts={},
  properties={Property("hasComponents", "list", "")}
);

Concept(
  name="AbioticFactor",
  description="A non-living physical or chemical element or process within an ecological system.",
  super_concepts={},
  properties={Property("type", "string", ""), Property("affects", "list", "")}
);

Concept(
  name="Simulation",
  description="A computerized modeling of an ecological system's behavior under various conditions. The process of running an ecological model to observe how the system behaves and evolves over time based on the defined parameters and initial conditions.",
  super_concepts={},
  properties={Property("initialConditions", "object", ""), Property("changedFactor", "list", ""), Property("predictedOutcome", "object", ""), Property("VERA workflow", "list", ""), Property("Entities/Components", "list", ""), Property("Relationships", "list", "")}
);

Concept(
  name="User",
  description="A person who interacts with VERA to explore ecological systems and run simulations. This person constructs models, sets and/or changes simulations parameters and runs models.",
  super_concepts={},
  properties={}
);

Concept(
  name="Ask_TMK",
  description="The explanation module within VERA that has access to the Task-Method-Knowledge (TMK) components. It provides information about how Vera created ecological systems and simulation results based on the TMK model, the user inputs on conceptual models and simulation parameters set by user. This module just provides explanation based on TMK and user inputs. The models are constructed in Vera based on user inputs only.",
  super_concepts={},
  properties={}
);

Concept(
  name="Behavior",
  description="An action or interaction defined within an ecological model that affects populations or abiotic factors.",
  super_concepts={},
  properties={Property("label", "string", ""), Property("actingAgentType", "AgentType", ""), Property("targetAgentType", "AgentType", ""), Property("interactionProbability", "number", "")}
);

Concept(
  name="AgentType",
  description="A specific type of organism within an ecological model (e.g., Rabbit, Grass, Fox).",
  super_concepts={},
  properties={Property("biotic", "boolean", ""), Property("initialPopulation", "number", ""), Property("maxPopulation", "number", ""), Property("behaviors", "list", "")}
);

Concept(
  name="Agent",
  description="An individual organism instance within a specific agent type in the simulation.",
  super_concepts={},
  properties={Property("agentType", "AgentType", ""), Property("carbonBiomass", "number", ""), Property("amount", "number", "")}
);

Concept(
  name="SimulationTick",
  description="A single time step within a simulation run.",
  super_concepts={},
  properties={Property("simulationInstance", "Simulation", ""), Property("behaviorsExecuted", "list", "")}
);

Concept(
  name="What_If_Experiment",
  description="A 'what if' experiment in VERA enables users to predict the outcome of future changes to an ecological system by modifying parameters and observing the resulting simulation.",
  super_concepts={},
  properties={Property("", "", "")}
);

Concept(
  name="SimulationState",
  description="The current state of a running simulation, including population counts and abiotic factor values.",
  super_concepts={},
  properties={Property("simulationInstance", "Simulation", "")}
);

Concept(
  name="SimulationParameter",
  description="A variable that can be set by the user to influence the behavior of a simulation. They are also referred to as entities in a simulation. There are 3 entities in a simulation: 1) Biotic Component, 2) Abiotic Component, 3) Habitat. The corresponding parameters for the three entities are below as a list. The Parameters are settings that control the behavior of components and relationships within a VERA simulation.",
  super_concepts={},
  properties={Property("Biotic Population", "string", ""), Property("AbioticSubstance", "string", ""), Property("Habitat", "string", ""), Property("Simulation Parameters", "list", "")}
);

concepts =  {project, model, model_canvas, 
			simulation, simulation_tab, 
			components, relationships, parameters }; 
			
Concept(name=project, description="A proejct is a way to organize your models.", super_concepts={}, properties={});
Concept(name=model, description="A conceptual model of your observed phenomenon.", super_concepts={}, properties={});
Concept(name=model_canvas, description="The graphical user interface where you buide your conceptual model.", super_concepts={}, properties={});
Concept(name=simulation, description="A graph that shows you how your components change over time.", super_concepts={}, properties={});
Concept(name=simulation_tab, description="The graphical user interface where you run simulation of your conceptual model.", super_concepts={}, properties={});
Concept(name=component, description="An element in your model.", super_concepts={}, properties={});
Concept(name=relationship, description="A description of how one component interact with another component in your model.", super_concepts={}, properties={});
Concept(name=property, description="An attribute of a component.", super_concepts={}, properties={});
Concept(name=parameter, description="A proporty which values determine the characteristics or behavior of an element in your model.", super_concepts={property}, properties={});

components =  { biotic, abiotic }; 
relationships =  {destroy, produce, consume, become, affect };
parameters =  {model_parameters, simulation_parameter, component_parameters, relationship_parameters };

Concept(name=simulation_parameter, description="A proporty which integer evalues determine duration of a simulation.", 
		super_concepts={parameter, simulation, simulation_tab}, properties={Property ("simulation time limit", INTEGER_LITERAL, 2000) });

Concept(name=component_parameter, description="A proporty which determine the characteristics of a component.", 
		super_concepts={parameter, component}, properties={});
		
Concept(name=relationship_parameter, description="A proporty which determine the behavior of a component.", 
		super_concepts={parameter, relationship}, properties={});

Concept(name=assimilation_efficiency, description="An attribute of a living component. When one thing consumes another, not all the carbon is assimilated by the consumer – some is burned off, some is passed as waste.  This parameter is the percentage of carbon biomass retained by the consumer.", 
		super_concepts={parameter, component}, 
		properties={Property ("unit", INTEGER_LITERAL, 1)});
		
Concept(name=move_velocity, description="An attribute of a living component. Average velocity of the organisms in this population as they move in their environment.", 
		super_concepts={parameter, component}, 
		properties={Property ("unit mile per second", FLOAT_LITERAL, 0.00001)});
		
Concept(name=biotic_component, description="A living element in your model.", super_concepts={component, component_parameter}, 
		properties={assimilation_efficiency, move_velocity });

Concept(name=consumption_rate, description="The number of prey consumed by the predator per simulation tick.", 
		super_concepts={parameter, component}, 
		properties={Property ("unit number", FLOAT_LITERAL, 0.5)});
		
Concept(name=interaction_probability, description="The likelihood that two related species come into sufficiently close contact that an interaction takes place.", 
		super_concepts={parameter, component}, 
		properties={Property ("unit percentage", FLOAT_LITERAL, 0.5)});

Concept(name=abiotic_component, description="An non living component.", super_concepts={component, component_parameter}, 
		properties={consumption_rate, interaction_probability});

Relation(consumes, "predator consumes prey", predator, prey);